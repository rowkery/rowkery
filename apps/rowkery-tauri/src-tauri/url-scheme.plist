<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- rowkery:// links from Rowkery's views in the chat (src/open_link.rs). tauri.conf.json merges this into the bundle's Info.plist (url-scheme-dev.plist for Rowkery Dev). -->
  <!-- macOS 15 asks before a connection to a database on the local network, with this line as the reason. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Rowkery connects to databases on your network.</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>dev.rowkery.app</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>rowkery</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
